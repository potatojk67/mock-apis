{
  "name": "CBS Loan Settlement",
  "description": "Tells core banking (CBS) that a payday loan payment/settlement was posted in Sumo, so CBS reduces the outstanding and the customer's limit is freed.",
  "method": "POST",
  "path": "/api/v1/cbs/settlements",
  "request": {
    "required_fields": ["customer_id", "loan_id"],
    "example": {
      "customer_id": "CUST-10045",
      "loan_id": "PDL-2026-000123",
      "amount_paid": "45230.00",
      "outstanding_before": "45230.00",
      "payment_date": "2026-10-09"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "status": "POSTED",
      "settlement_ref": "CBS-STL-{{random.int(100000,999999)}}",
      "customer_id": "{{body.customer_id}}",
      "loan_id": "{{body.loan_id}}",
      "amount_paid": "{{body.amount_paid}}",
      "remaining_outstanding": "0.00",
      "currency": "NPR"
    }
  }
}
